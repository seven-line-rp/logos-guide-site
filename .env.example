# Ключ модели, которая отвечает за LOGOS AI. Держится только на сервере:
# в React-код и переменные VITE_* его добавлять нельзя.
LOGOS_AI_API_KEY=replace-with-your-model-api-key
PORT=3000

# (Необязательно) Полный URL внешнего сервера API, если сайт и ИИ живут
# на разных хостингах. Например, фронт на reg.ru (shared), а /api/chat — на
# Railway/Render. Оставьте пустым, если фронт и сервер на одном домене.
# VITE_ASSISTANT_API_URL=https://logos-ai.up.railway.app
