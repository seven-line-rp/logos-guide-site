# ЛОГОС:Путеводитель — одностраничное приложение (React Router).
# Без этих правил перезагрузка страницы по адресу /map, /rooms, /route и т.д.
# отдаёт «404 — страница не найдена», потому что сервер ищет файл с таким именем.
# Файл загружается вместе с dist и работает на общем хостинге reg.ru (Apache).
# Подробности и вариант для nginx — в deploy/reg-ru.md.

DirectoryIndex index.html
# /rooms — это и раздел сайта, и папка с фото кабинетов. Без этой строки Apache
# перенаправил бы /rooms на /rooms/ и показал «403 Forbidden» вместо страницы.
DirectorySlash Off

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 0. Один адрес сайта. www.logos-guide.ru и технический адрес хостинга
  #    навсегда (301) перенаправляются на https://logos-guide.ru — тогда в поиске
  #    показывается только основной домен, а не копия сайта на другом адресе.
  RewriteCond %{HTTP_HOST} !^logos-guide\.ru$ [NC]
  RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:[0-9]+)?$ [NC]
  RewriteCond %{HTTP_HOST} !^$
  RewriteRule ^ https://logos-guide.ru%{REQUEST_URI} [R=301,L,NE]

  # 0.5. Разделы сайта с собственными заголовком и описанием для поисковиков и превью
  #      ссылок: /map отдаёт _pages/map.html (их пишет сборка, см. vite.config.js).
  #      Внутри тот же index.html, только с другими title, description и og-тегами.
  RewriteCond %{DOCUMENT_ROOT}/_pages/$1.html -f
  RewriteRule ^([a-z-]+)$ _pages/$1.html [L]

  # 1. Существующие файлы (assets/, voice/, team/, картинки) отдаём как есть.
  #    Папки сюда не входят: адрес вида /rooms должен открыть раздел приложения.
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # 2. Запросы к отсутствующей статике честно отдают 404: иначе браузер получит
  #    HTML вместо js, css или mp3 и страница «сломается» без внятной причины.
  RewriteCond %{REQUEST_URI} ^/(assets|voice|team|rooms)/ [OR]
  RewriteCond %{REQUEST_URI} \.(js|mjs|css|map|mp3|png|jpe?g|gif|svg|webp|ico|webmanifest|xml|txt)$ [NC]
  RewriteRule ^ - [L]

  # 3. Всё остальное — адреса разделов приложения: отдаём index.html,
  #    а нужный маршрут определит React Router.
  RewriteRule ^ index.html [L]
</IfModule>

# Страховка, если mod_rewrite отключён или панель хостинга переопределяет правила:
# серверная страница 404 запомнит адрес и вернёт посетителя на ту же страницу.
ErrorDocument 404 /404.html
