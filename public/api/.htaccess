# ИИ-агент: снаружи доступны только PHP-эндпоинты (ai-chat, notices, report, search-miss). Конфиг с ключом (если его
# положили сюда, а не уровнем выше) и база знаний напрямую не отдаются.
<FilesMatch "^(?!(ai-chat|notices|report|search-miss)\.php$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
